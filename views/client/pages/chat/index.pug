extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    // Thanh menu nút chuyển hướng danh sách người dùng & bạn bè
    include ../../partials/list-btn-user.pug

    
    // Tiêu đề trang Chat
    .row
      .col-12
        +box-head("Chat")

    // Khung giao diện Chat
    .row
      .col-12
        .chat(my-id=user.id, my-full-name=user.fullName)
          .inner-body
            each chat in chats
              div(class=(chat.user_id == user.id ? "inner-outgoing" : "inner-incoming"))
                if(chat.user_id != user.id)
                  .inner-name #{chat.infoUser ? chat.infoUser.fullName : ""}
                if(chat.content)
                  .inner-content
                    | #{chat.content}
                if(chat.images && chat.images.length > 0)
                  .inner-images
                    each img in chat.images
                      img(src=img)

            div(class="inner-list-typing")

          .inner-foot
            // Container preview ảnh chuẩn thiết kế tĩnh Facebook
            div(class="custom-file-container inner-preview-images" data-upload-id="upload-image")

            form(
              class="inner-form"
              action=""
            )
              input(
                type="text"
                placeholder="Nhập nội dung..."
                name="content"
              )

              label(for="file-upload-with-preview-upload-image" class="button-upload btn btn-light mx-1 mb-0")
                i.fa-regular.fa-image

              span(class="button-icon btn btn-light mx-1")
                i.fa-solid.fa-face-smile
              
              div(class="tooltip" role="tooltip")
                emoji-picker

              button
                i.fa-solid.fa-paper-plane

block script
  script(src="/js/chat.js")