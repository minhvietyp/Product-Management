extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3

    include ../../partials/list-btn-user.pug
    

    .row
      .col-12
        +box-head("Lời mời đã gửi")

    .row
      each user in users 
        .col-6
          // Thêm class 'add' để kích hoạt ẩn nút 'Kết bạn' và hiện nút 'Hủy'
          div(class="box-user add")
            div(class="inner-avatar" status=user.statusOnline)
              img(
                src=(user.avatar ? user.avatar : "/images/avatar.png")
                alt=user.fullName
              )
            div(class="inner-info")
              div(class="inner-name") #{user.fullName}
              div(class="inner-buttons")
                button(
                  class="btn btn-sm btn-primary mr-1"
                  btn-add-friend=user.id
                ) Kết bạn
                button(
                  class="btn btn-sm btn-secondary mr-1"
                  btn-cancel-friend=user.id
                ) Hủy lời mời

block script
  script(src="/js/users.js")