extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3

    include ../../partials/list-btn-user.pug

    .row
      .col-12
        +box-head("Lời mời kết bạn")

    .row(data-users-accept= user.id)
      each user in users 
        .col-6(user-id = user.id)
          div(class="box-user" user-id=user.id)
            div(class="inner-avatar" status=user.statusOnline)
              img(
                src=(user.avatar ? user.avatar : "/images/avatar.png")
                alt=user.fullName
              )
            div(class="inner-info")
              div(class="inner-name") #{user.fullName}
              div(class="inner-buttons")
                button(
                  class="btn btn-sm btn-primary mr-1"
                  btn-accept-friend=user.id
                ) Chấp nhận 
                button(
                  class="btn btn-sm btn-secondary mr-1"
                  btn-refuse-friend=user.id
                ) Xóa

                // Khối hiển thị thông báo trạng thái sau khi tương tác (ví dụ: "Đã chấp nhận", "Đã từ chối")
                button(
                  class="btn btn-sm btn-secondary mr-1"
                  btn-deleted-friend
                  disabled
                ) Đã từ chối
                button(
                  class="btn btn-sm btn-secondary mr-1"
                  btn-accept-friend
                  disabled
                ) Đã chấp nhận

block script
  script(src="/js/users.js")